lemma no_replay:
  all-traces
  "∀ R U A1 g ch op n #i #k.
    ((Accept( R, U, A1, g, ch, op, n ) @ #i) ∧
     (Accept( R, U, A1, g, ch, op, n ) @ #k)) ⇒
    (#i = #k)"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g ch op n #i #k.
  (Accept( R, U, A1, g, ch, op, n ) @ #i) ∧
  (Accept( R, U, A1, g, ch, op, n ) @ #k)
 ∧
  ¬(#i = #k)"
*/
by sorry

lemma revocation:
  all-traces
  "∀ R U A1 g ch op n #i #j.
    (((Accept( R, U, A1, g, ch, op, n ) @ #i) ∧ (Revoke( g ) @ #j)) ∧
     (#j < #i)) ⇒
    (∃ aud s #k. (Issue( U, A1, g, ch, aud, s ) @ #k) ∧ (#k < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g ch op n #i #j.
  (Accept( R, U, A1, g, ch, op, n ) @ #i) ∧ (Revoke( g ) @ #j)
 ∧
  (#j < #i) ∧
  (∀ aud s #k. (Issue( U, A1, g, ch, aud, s ) @ #k) ⇒ ¬(#k < #j))"
*/
simplify
solve( !Consent( U, A1, s, g ) ▶₀ #j )
  case Consent
  solve( Accept( R, U.1, A1.1, ~g, ch, op, n ) @ #i )
    case R_accept_eq
    solve( !PkAS( pk(x) ) ▶₀ #i )
      case AS_key
      solve( !KU( ~g ) @ #vk.9 )
        case AS_issue_root
        solve( !KU( sign(<'T', U, A1, ~g, <Al, p>, $R, op, pk(x)>, ~kas)
               ) @ #vk.21 )
          case AS_exchange_deleg_eq
          by contradiction /* from formulas */
        next
          case AS_exchange_deleg_sub
          by contradiction /* from formulas */
        next
          case AS_exchange_root_eq
          by contradiction /* from formulas */
        next
          case AS_exchange_root_sub
          by contradiction /* from formulas */
        next
          case c_sign
          by solve( !KU( ~kas ) @ #vk.25 )
        qed
      qed
    qed
  next
    case R_accept_sub
    solve( !PkAS( pk(x) ) ▶₀ #i )
      case AS_key
      solve( !KU( ~g ) @ #vk.9 )
        case AS_issue_root
        solve( !KU( sign(<'T', U, A1, ~g, <Al, p>, $R, (op++rest), pk(x)>, ~kas)
               ) @ #vk.23 )
          case AS_exchange_deleg_eq
          by contradiction /* from formulas */
        next
          case AS_exchange_deleg_sub
          by contradiction /* from formulas */
        next
          case AS_exchange_root_eq
          by contradiction /* from formulas */
        next
          case AS_exchange_root_sub
          by contradiction /* from formulas */
        next
          case c_sign
          by solve( !KU( ~kas ) @ #vk.27 )
        qed
      qed
    qed
  qed
qed

lemma attenuation_honest_agents:
  all-traces
  "∀ R U A1 g ch op n #i.
    ((Accept( R, U, A1, g, ch, op, n ) @ #i) ∧
     (¬(∃ X #c. Compromised( X ) @ #c))) ⇒
    (∃ s0 #j.
      (Grant( U, A1, s0, g ) @ #j) ∧ ((s0 = op) ∨ (∃ r. s0 = (op++r))))"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g ch op n #i.
  (Accept( R, U, A1, g, ch, op, n ) @ #i)
 ∧
  (∀ X #c. (Compromised( X ) @ #c) ⇒ ⊥) ∧
  (∀ s0 #j.
    (Grant( U, A1, s0, g ) @ #j) ⇒ (¬(s0 = op)) ∧ (∀ r. (s0 = (op++r)) ⇒ ⊥))"
*/
simplify
solve( Accept( R, U, A1, g, ch, op, n ) @ #i )
  case R_accept_eq
  solve( !PkAS( pk(x) ) ▶₀ #i )
    case AS_key
    solve( !KU( sign(<'T', U, A1, g, <Al, p>, $R, op, pk(x)>, ~kas)
           ) @ #vk.20 )
      case AS_exchange_deleg_eq
      solve( (s0 = op)  ∥ (∃ r. (s0 = (op++r))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case AS_exchange_deleg_sub
      solve( (s0 = op)  ∥ (∃ r. (s0 = (op++r))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case AS_exchange_root_eq
      solve( (s0 = op)  ∥ (∃ r. (s0 = (op++r))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case AS_exchange_root_sub
      solve( (s0 = op)  ∥ (∃ r. (s0 = (op++r))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case c_sign
      by solve( !KU( ~kas ) @ #vk.24 )
    qed
  qed
next
  case R_accept_sub
  solve( !PkAS( pk(x) ) ▶₀ #i )
    case AS_key
    solve( !KU( sign(<'T', U, A1, g, <Al, p>, $R, (op++rest), pk(x)>, ~kas)
           ) @ #vk.22 )
      case AS_exchange_deleg_eq
      solve( (s0 = (op++rest))  ∥ (∃ r. (s0 = (op++r++rest))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case AS_exchange_deleg_sub
      solve( (s0 = (op++rest))  ∥ (∃ r. (s0 = (op++r++rest))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case AS_exchange_root_eq
      solve( (s0 = (op++rest))  ∥ (∃ r. (s0 = (op++r++rest))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case AS_exchange_root_sub
      solve( (s0 = (op++rest))  ∥ (∃ r. (s0 = (op++r++rest))) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case c_sign
      by solve( !KU( ~kas ) @ #vk.26 )
    qed
  qed
qed

lemma holder_and_audience_network_only:
  all-traces
  "∀ R U A1 g Al p op n #i.
    ((Accept( R, U, A1, g, <Al, p>, op, n ) @ #i) ∧
     (¬(∃ X #c. Compromised( X ) @ #c))) ⇒
    (∃ #j. (Send( Al, R, U, <Al, p>, op, n ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g Al p op n #i.
  (Accept( R, U, A1, g, <Al, p>, op, n ) @ #i)
 ∧
  (∀ X #c. (Compromised( X ) @ #c) ⇒ ⊥) ∧
  (∀ #j. (Send( Al, R, U, <Al, p>, op, n ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( Accept( R, U, A1, g, <Al, p>, op, n ) @ #i )
  case R_accept_eq
  solve( !PkAS( pk(x) ) ▶₀ #i )
    case AS_key
    solve( !KU( sign(<'T', U, A1, g, <Al, p>, $R, op, pk(x)>, ~kas)
           ) @ #vk.20 )
      case AS_exchange_deleg_eq
      solve( (s0 = op)  ∥ (∃ r. (s0 = (op++r))) )
        case case_1
        solve( !KU( ~g ) @ #vk.14 )
          case AS_issue_root
          solve( !KU( sign(<'REQ', 
                            <'T', $U, $A1, ~g, <$X, Ap, p>, $R, op, pk(~k)>, op, $R, n>,
                           ~k)
                 ) @ #vk.36 )
            case Agent_invoke_eq
            by contradiction /* from formulas */
          next
            case c_sign
            solve( !KU( ~k ) @ #vk.50 )
              case Reveal_agent
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case case_2
        solve( !KU( ~g ) @ #vk.14 )
          case AS_issue_root
