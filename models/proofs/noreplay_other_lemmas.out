lemma scope_invariant [use_induction, reuse]:
  all-traces
  "∀ U A1 g ch aud s #i.
    (Issue( U, A1, g, ch, aud, s ) @ #i) ⇒
    (∃ s0 #j.
      ((Grant( U, A1, s0, g ) @ #j) ∧ (#j < #i)) ∧
      ((s0 = s) ∨ (∃ r. s0 = (r++s))))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g ch aud s #i.
  (Issue( U, A1, g, ch, aud, s ) @ #i)
 ∧
  ∀ s0 #j.
   (Grant( U, A1, s0, g ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨ ((¬(s0 = s)) ∧ (∀ r. (s0 = (r++s)) ⇒ ⊥)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (last(#i))  ∥
         (∃ s0 #j.
           (Grant( U, A1, s0, g ) @ #j)
          ∧
           (¬(last(#j))) ∧ (#j < #i) ∧ (((s0 = s) ∨ (∃ r. (s0 = (r++s)))))) )
    case case_1
    solve( Issue( U, A1, g, ch, aud, s ) @ #i )
      case AS_exchange_deleg_eq
      solve( !LtkAS( kas ) ▶₀ #i )
        case AS_key
        solve( !Pk( An, pkn ) ▶₁ #i )
          case Agent_key
          solve( !KU( sign(<'T', U, A1, g, <Ap, p>, 'as', s, pk(x)>, ~kas)
                 ) @ #vk.25 )
            case AS_exchange_deleg_eq
            solve( (s0 = s)  ∥ (∃ r. (s0 = (r++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case AS_exchange_deleg_sub
            solve( (s0 = s)  ∥ (∃ r. (s0 = (r++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case AS_exchange_root_eq
            solve( (s0 = s)  ∥ (∃ r. (s0 = (r++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case AS_exchange_root_sub
            solve( (s0 = s)  ∥ (∃ r. (s0 = (r++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case c_sign
            by solve( !KU( ~kas ) @ #vk.30 )
          qed
        qed
      qed
    next
      case AS_exchange_deleg_sub
      solve( !LtkAS( kas ) ▶₀ #i )
        case AS_key
        solve( !Pk( An, pkn ) ▶₁ #i )
          case Agent_key
          solve( !KU( sign(<'T', U, A1, g, <Ap, p>, 'as', (rest++s), pk(x)>, ~kas)
                 ) @ #vk.27 )
            case AS_exchange_deleg_eq
            solve( (s0 = (rest++s))  ∥ (∃ r. (s0 = (r++rest++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case AS_exchange_deleg_sub
            solve( (s0 = (rest++s))  ∥ (∃ r. (s0 = (r++rest++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case AS_exchange_root_eq
            solve( (s0 = (rest++s))  ∥ (∃ r. (s0 = (r++rest++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case AS_exchange_root_sub
            solve( (s0 = (rest++s))  ∥ (∃ r. (s0 = (r++rest++s))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            qed
          next
            case c_sign
            by solve( !KU( ~kas ) @ #vk.32 )
          qed
        qed
      qed
    next
      case AS_exchange_root_eq
      solve( !LtkAS( kas ) ▶₀ #i )
        case AS_key
        solve( !Pk( An, pkn ) ▶₁ #i )
          case Agent_key
          solve( !KU( sign(<'T', U, A1, g, A1, 'as', s, pk(x)>, ~kas) ) @ #vk.22 )
            case AS_issue_root
            by contradiction /* from formulas */
          next
            case c_sign
            by solve( !KU( ~kas ) @ #vk.27 )
          qed
        qed
      qed
    next
      case AS_exchange_root_sub
      solve( !LtkAS( kas ) ▶₀ #i )
        case AS_key
        solve( !Pk( An, pkn ) ▶₁ #i )
          case Agent_key
          solve( !KU( sign(<'T', U, A1, g, A1, 'as', (rest++s), pk(x)>, ~kas)
                 ) @ #vk.24 )
            case AS_issue_root
            by contradiction /* from formulas */
          next
            case c_sign
            by solve( !KU( ~kas ) @ #vk.29 )
          qed
        qed
      qed
    next
      case AS_issue_root
      solve( !Consent( U, A1, s, g ) ▶₀ #i )
        case Consent
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    solve( (s0 = s)  ∥ (∃ r. (s0 = (r++s))) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma attenuation:
