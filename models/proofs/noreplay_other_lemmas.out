                     (op.35++rest.39), pkh.38>,
                    x.53)
       sr    = sr.41
       z     = true
       z.1   = verify(sr.41,
                      <'REQ', 
                       <'T', U.32, A1.30, g.33, <Al.31, p.36>, $R.29, (op.35++rest.39), pkh.38
                       >, 
                       op.35, $R.29, n.34>,
                      pkh.38)
  */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction SingleAS:
  "∀ #i #j. ((OnlyOnceAS( ) @ #i) ∧ (OnlyOnceAS( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OneKeyPerAgent:
  "∀ X #i #j. ((KeyGen( X ) @ #i) ∧ (KeyGen( X ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction RevokedGrant:
  "∀ g #i #j. ((Live( g ) @ #i) ∧ (Revoke( g ) @ #j)) ⇒ (#i < #j)"
  // safety formula

lemma executable:
  exists-trace
  "∃ R U A1 A2 A3 g op n #i #k.
    (((((Accept( R, U, A1, g, <A3, A2, A1>, op, n ) @ #i) ∧
        (Grant( U, A1, op, g ) @ #k)) ∧
       (¬(∃ X #c. Compromised( X ) @ #c))) ∧
      (¬(A1 = A2))) ∧
     (¬(A2 = A3))) ∧
    (¬(A1 = A3))"
/*
guarded formula characterizing all satisfying traces:
"∃ R U A1 A2 A3 g op n #i #k.
  (Accept( R, U, A1, g, <A3, A2, A1>, op, n ) @ #i) ∧
  (Grant( U, A1, op, g ) @ #k)
 ∧
  (∀ X #c. (Compromised( X ) @ #c) ⇒ ⊥) ∧
  (¬(A1 = A2)) ∧
  (¬(A2 = A3)) ∧
  (¬(A1 = A3))"
*/
simplify
solve( Accept( R, $U, $A1, ~g, <A3, A2, $A1>, op, n ) @ #i )
  case R_accept_eq
  solve( !PkAS( pk(x) ) ▶₀ #i )
