                              <'T', $U, $A1, ~g, <$X.1, $A1>, 'as', s, pk(~k.1)>, 
                              sign(<'T', $U, $A1, ~g, <$X.1, $A1>, 'as', s, pk(~k.1)>, ~kas), $X, R, 
