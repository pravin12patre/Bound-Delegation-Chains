                     (rest.82++s2.83), pk(x.140)>,
                    kas.77)
       sx    = sign(<'XR', 
                     <'T', U.75, A1.71, g.76, <Ap.73, p.79>, 'as', (rest.82++s2.83), pk(x.140)
                     >, 
                     sign(<'T', U.75, A1.71, g.76, <Ap.73, p.79>, 'as', (rest.82++s2.83), 
