lemma hop_authentic_network_only:
  all-traces
  "∀ U A1 g Ap An R s p #i.
    ((Hop( U, A1, g, Ap, An, R, s, p ) @ #i) ∧
     (¬(∃ X #c. Compromised( X ) @ #c))) ⇒
    (∃ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g Ap An R s p #i.
  (Hop( U, A1, g, Ap, An, R, s, p ) @ #i)
 ∧
  (∀ X #c. (Compromised( X ) @ #c) ⇒ ⊥) ∧
  (∀ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( Hop( U, A1, g, Ap, An, R, s, p ) @ #i )
  case AS_exchange_deleg_eq
  solve( (s0 = s)  ∥ (∃ r. (s0 = (r++s))) )
    case case_1
    solve( !LtkAS( kas ) ▶₀ #i )
      case AS_key
      solve( !Pk( An, pkn ) ▶₁ #i )
        case Agent_key
        solve( !KU( ~g ) @ #vk.11 )
          case AS_issue_root
          solve( !KU( sign(<'T', $U, $A1, ~g, <Ap, p>, 'as', s, pk(x)>, ~kas)
                 ) @ #vk.25 )
            case AS_exchange_deleg_eq
            solve( !KU( sign(<'XR', 
                              <'T', $U, $A1, ~g, <$X.1, Ap, p>, 'as', s, pk(~k.1)>, 
                              sign(<'T', $U, $A1, ~g, <$X.1, Ap, p>, 'as', s, pk(~k.1)>, ~kas), $X, R, 
                              s, nx>,
                             ~k.1)
                   ) @ #vk.40 )
              case Agent_delegate_deleg_eq
              by contradiction /* from formulas */
            next
              case c_sign
              solve( !KU( ~k.1 ) @ #vk.50 )
                case Reveal_agent
                by contradiction /* from formulas */
              qed
            qed
          next
            case AS_exchange_deleg_sub
            solve( !KU( sign(<'XR', 
                              <'T', $U, $A1, ~g, <$X.1, Ap, p>, 'as', s, pk(~k.1)>, 
                              sign(<'T', $U, $A1, ~g, <$X.1, Ap, p>, 'as', s, pk(~k.1)>, ~kas), $X, R, 
                              s, nx>,
                             ~k.1)
                   ) @ #vk.40 )
              case Agent_delegate_deleg_eq
              by contradiction /* from formulas */
            next
              case c_sign
              solve( !KU( ~k.1 ) @ #vk.52 )
                case Reveal_agent
                by contradiction /* from formulas */
              qed
            qed
          next
            case AS_exchange_root_eq
            solve( !KU( sign(<'XR', 
                              <'T', $U, $A1, ~g, <$X.1, $A1>, 'as', s, pk(~k.1)>, 
                              sign(<'T', $U, $A1, ~g, <$X.1, $A1>, 'as', s, pk(~k.1)>, ~kas), $X, R, 
                              s, nx>,
                             ~k.1)
                   ) @ #vk.39 )
              case Agent_delegate_deleg_eq
              by contradiction /* from formulas */
            next
              case c_sign
