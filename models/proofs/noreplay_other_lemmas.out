rule (modulo E) Agent_invoke_eq:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, <X, p>, R, op, pk(k)>, sig> ), Fr( ~n ), In( op )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <X, p>, R, op, pk(k)>, pkas), true ),
  Send( X, R, U, <X, p>, op, ~n )
  ]->
   [
   Out( <<'T', U, A1, g, <X, p>, R, op, pk(k)>, sig, op, ~n, 
         sign(<'REQ', <'T', U, A1, g, <X, p>, R, op, pk(k)>, op, R, ~n>, k)>
   )
   ]

  /*
