lemma hop_authentic:
  all-traces
  "∀ U A1 g Ap An R s p #i.
    ((Hop( U, A1, g, Ap, An, R, s, p ) @ #i) ∧
     (¬(∃ #c. Compromised( Ap ) @ #c))) ⇒
    (∃ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g Ap An R s p #i.
  (Hop( U, A1, g, Ap, An, R, s, p ) @ #i)
 ∧
  (∀ #c. (Compromised( Ap ) @ #c) ⇒ ⊥) ∧
  (∀ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
