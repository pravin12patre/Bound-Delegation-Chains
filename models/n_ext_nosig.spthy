theory BDC_ext_nosig
begin

builtins: signing, multiset
functions: cn/2

rule Agent_key:
  [ Fr(~k) ] --[ KeyGen($X) ]-> [ !Ltk($X, ~k), !Pk($X, pk(~k)), Out(pk(~k)) ]

rule Reveal_agent:
  [ !Ltk(X, k) ] --[ Compromised(X) ]-> [ Out(k) ]

rule AS_key:
  [ Fr(~kas) ] --[ OnlyOnceAS() ]-> [ !LtkAS(~kas), !PkAS(pk(~kas)), Out(pk(~kas)) ]

// User U consents (out of band) to agent A1 acting with scope s; g identifies the grant.
rule Consent:
  [ Fr(~g), In(s) ] --[ Grant($U, $A1, s, ~g) ]-> [ !Consent($U, $A1, s, ~g) ]

// User revokes a grant at the AS.
rule Revoke:
  [ !Consent(U, A1, s, g), !LtkAS(kas) ] --[ Revoke(g) ]-> [ Out(<<'REV', g>, sign(<'REV', g>, kas)>) ]

// A resource learns of a revocation from a notice (signed by the AS unless ext_nosig).
rule R_learn_revocation:
  [ !PkAS(pkas), In(<<'REV', g>, sg>) ]
  --[ RLearn($R, g) ]->
  [ !RRevoked($R, g) ]

rule AS_issue_root:
  let m = <'T', U, A1, g, A1, 'as', s, pk1> in
  [ !Consent(U, A1, s, g), !Pk(A1, pk1), !LtkAS(kas) ]
  --[ Issue(U, A1, g, A1, 'as', s), Live(g) ]->
  [ Out(<m, sign(m, kas)>) ]

rule Agent_delegate_root_eq:
  let m = <'T', U, A1, g, X, 'as', s, pk(k)>
      x = <'XR', m, sig, An, R, s, ~nx> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), In(<An, R>), Fr(~nx) ]
  --[ Eq(verify(sig, m, pkas), true), Delegate(X, An, R, U, s, X) ]->
  [ Out(<x, sign(x, k)>) ]

rule Agent_delegate_root_sub:
  let m = <'T', U, A1, g, X, 'as', s2 + rest, pk(k)>
      x = <'XR', m, sig, An, R, s2, ~nx> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), In(<An, R>), Fr(~nx) ]
  --[ Eq(verify(sig, m, pkas), true), Delegate(X, An, R, U, s2, X) ]->
  [ Out(<x, sign(x, k)>) ]

rule Agent_delegate_deleg_eq:
  let m = <'T', U, A1, g, <X, p>, 'as', s, pk(k)>
      x = <'XR', m, sig, An, R, s, ~nx> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), In(<An, R>), Fr(~nx) ]
  --[ Eq(verify(sig, m, pkas), true), Delegate(X, An, R, U, s, <X, p>) ]->
  [ Out(<x, sign(x, k)>) ]

rule Agent_delegate_deleg_sub:
  let m = <'T', U, A1, g, <X, p>, 'as', s2 + rest, pk(k)>
      x = <'XR', m, sig, An, R, s2, ~nx> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), In(<An, R>), Fr(~nx) ]
  --[ Eq(verify(sig, m, pkas), true), Delegate(X, An, R, U, s2, <X, p>) ]->
  [ Out(<x, sign(x, k)>) ]

rule AS_exchange_root_eq:
  let m  = <'T', U, A1, g, A1, 'as', s, pkh>
      x  = <'XR', m, sig, An, R, s, nx>
      m2 = <'T', U, A1, g, <An, A1>, R, s, pkn> in
  [ !LtkAS(kas), !Pk(An, pkn), In(<x, sx>) ]
  --[ Eq(verify(sig, m, pk(kas)), true), Eq(verify(sx, x, pkh), true),
      Issue(U, A1, g, <An, A1>, R, s), Hop(U, A1, g, A1, An, R, s, A1), Live(g) ]->
  [ Out(<m2, sign(m2, kas)>) ]

rule AS_exchange_root_sub:
  let m  = <'T', U, A1, g, A1, 'as', s2 + rest, pkh>
      x  = <'XR', m, sig, An, R, s2, nx>
      m2 = <'T', U, A1, g, <An, A1>, R, s2, pkn> in
  [ !LtkAS(kas), !Pk(An, pkn), In(<x, sx>) ]
  --[ Eq(verify(sig, m, pk(kas)), true), Eq(verify(sx, x, pkh), true),
      Issue(U, A1, g, <An, A1>, R, s2), Hop(U, A1, g, A1, An, R, s2, A1), Live(g) ]->
  [ Out(<m2, sign(m2, kas)>) ]

rule AS_exchange_deleg_eq:
  let m  = <'T', U, A1, g, <Ap, p>, 'as', s, pkh>
      x  = <'XR', m, sig, An, R, s, nx>
      m2 = <'T', U, A1, g, <An, <Ap, p>>, R, s, pkn> in
  [ !LtkAS(kas), !Pk(An, pkn), In(<x, sx>) ]
  --[ Eq(verify(sig, m, pk(kas)), true), Eq(verify(sx, x, pkh), true),
      Issue(U, A1, g, <An, <Ap, p>>, R, s), Hop(U, A1, g, Ap, An, R, s, <Ap, p>), Live(g) ]->
  [ Out(<m2, sign(m2, kas)>) ]

rule AS_exchange_deleg_sub:
  let m  = <'T', U, A1, g, <Ap, p>, 'as', s2 + rest, pkh>
      x  = <'XR', m, sig, An, R, s2, nx>
      m2 = <'T', U, A1, g, <An, <Ap, p>>, R, s2, pkn> in
  [ !LtkAS(kas), !Pk(An, pkn), In(<x, sx>) ]
  --[ Eq(verify(sig, m, pk(kas)), true), Eq(verify(sx, x, pkh), true),
      Issue(U, A1, g, <An, <Ap, p>>, R, s2), Hop(U, A1, g, Ap, An, R, s2, <Ap, p>), Live(g) ]->
  [ Out(<m2, sign(m2, kas)>) ]

rule Agent_invoke_eq:
  let m = <'T', U, A1, g, <X, p>, R, op, pk(k)>
      q = <'REQ', m, op, R, ~n> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), Fr(~n), In(op) ]
  --[ Eq(verify(sig, m, pkas), true), Send(X, R, U, <X, p>, op, ~n) ]->
  [ Out(<m, sig, op, ~n, sign(q, k)>) ]

rule Agent_invoke_sub:
  let m = <'T', U, A1, g, <X, p>, R, op + rest, pk(k)>
      q = <'REQ', m, op, R, ~n> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), Fr(~n), In(op) ]
  --[ Eq(verify(sig, m, pkas), true), Send(X, R, U, <X, p>, op, ~n) ]->
  [ Out(<m, sig, op, ~n, sign(q, k)>) ]

rule R_accept_eq:
  let m = <'T', U, A1, g, <Al, p>, $R, op, pkh> in
  [ !PkAS(pkas), In(<m, sig, op, n, sr>) ]
  --[ Eq(verify(sig, m, pkas), true), Eq(verify(sr, <'REQ', m, op, $R, n>, pkh), true), Accept($R, U, A1, g, <Al, p>, op, n), RNonce($R, n) ]->
  [ ]

rule R_accept_sub:
  let m = <'T', U, A1, g, <Al, p>, $R, op + rest, pkh> in
  [ !PkAS(pkas), In(<m, sig, op, n, sr>) ]
  --[ Eq(verify(sig, m, pkas), true), Eq(verify(sr, <'REQ', m, op, $R, n>, pkh), true), Accept($R, U, A1, g, <Al, p>, op, n), RNonce($R, n) ]->
  [ ]

rule Agent_delegate_root_refine_one:
  let m = <'T', U, A1, g, X, 'as', e, pk(k)>
      x = <'XR', m, sig, An, R, cn(e, kk), ~nx> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), In(<An, R, kk>), Fr(~nx) ]
  --[ Eq(verify(sig, m, pkas), true), Delegate(X, An, R, U, cn(e, kk), X) ]->
  [ Out(<x, sign(x, k)>) ]

rule Agent_delegate_deleg_refine_one:
  let m = <'T', U, A1, g, <X, p>, 'as', e, pk(k)>
      x = <'XR', m, sig, An, R, cn(e, kk), ~nx> in
  [ !Ltk(X, k), !PkAS(pkas), In(<m, sig>), In(<An, R, kk>), Fr(~nx) ]
  --[ Eq(verify(sig, m, pkas), true), Delegate(X, An, R, U, cn(e, kk), <X, p>) ]->
  [ Out(<x, sign(x, k)>) ]

rule AS_exchange_root_refine_one:
  let m  = <'T', U, A1, g, A1, 'as', e, pkh>
      x  = <'XR', m, sig, An, R, cn(e, kk), nx>
      m2 = <'T', U, A1, g, <An, A1>, R, cn(e, kk), pkn> in
  [ !LtkAS(kas), !Pk(An, pkn), In(<x, sx>) ]
  --[ Eq(verify(sig, m, pk(kas)), true), Eq(verify(sx, x, pkh), true),
      Issue(U, A1, g, <An, A1>, R, cn(e, kk)), Hop(U, A1, g, A1, An, R, cn(e, kk), A1),
      Refine(U, A1, g, e, cn(e, kk), A1, 'as', e), Live(g) ]->
  [ Out(<m2, sign(m2, kas)>) ]

rule AS_exchange_deleg_refine_one:
  let m  = <'T', U, A1, g, <Ap, p>, 'as', e, pkh>
      x  = <'XR', m, sig, An, R, cn(e, kk), nx>
      m2 = <'T', U, A1, g, <An, <Ap, p>>, R, cn(e, kk), pkn> in
  [ !LtkAS(kas), !Pk(An, pkn), In(<x, sx>) ]
  --[ Eq(verify(sig, m, pk(kas)), true), Eq(verify(sx, x, pkh), true),
      Issue(U, A1, g, <An, <Ap, p>>, R, cn(e, kk)), Hop(U, A1, g, Ap, An, R, cn(e, kk), <Ap, p>),
      Refine(U, A1, g, e, cn(e, kk), <Ap, p>, 'as', e), Live(g) ]->
  [ Out(<m2, sign(m2, kas)>) ]

// A resource that has learned of the revocation of g accepts nothing more under g.
restriction PushedRevocation:
  "All R U A1 g ch op n #i #j. Accept(R, U, A1, g, ch, op, n) @ #i & RLearn(R, g) @ #j ==> #i < #j"

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction SingleAS:
  "All #i #j. OnlyOnceAS() @ #i & OnlyOnceAS() @ #j ==> #i = #j"

restriction OneKeyPerAgent:
  "All X #i #j. KeyGen(X) @ #i & KeyGen(X) @ #j ==> #i = #j"

// The AS issues nothing for a grant after the user has revoked it.
restriction RevokedGrant:
  "All g #i #j. Live(g) @ #i & Revoke(g) @ #j ==> #i < #j"

restriction ReplayCache:
  "All R n #i #j. RNonce(R, n) @ #i & RNonce(R, n) @ #j ==> #i = #j"

// Sanity: a chain of three distinct agents completes without any compromise.
lemma executable:
  exists-trace
  "Ex R U A1 A2 A3 g op n #i #k. Accept(R, U, A1, g, <A3, <A2, A1>>, op, n) @ #i & Grant(U, A1, op, g) @ #k
     & not (Ex X #c. Compromised(X) @ #c) & not (A1 = A2) & not (A2 = A3) & not (A1 = A3)"

// P2 Holder and audience binding: an accepted request from an honest final holder was sent by it, to R.
lemma holder_and_audience:
  "All R U A1 g Al p op n #i. Accept(R, U, A1, g, <Al, p>, op, n) @ #i
     & not (Ex #c. Compromised(Al) @ #c) ==>
     (Ex #j. Send(Al, R, U, <Al, p>, op, n) @ #j & #j < #i)"

// P3a Every accepted chain was issued by the AS for this audience, with a scope covering op.
lemma accepted_chain_issued:
  "All R U A1 g ch op n #i. Accept(R, U, A1, g, ch, op, n) @ #i ==>
     (Ex s #j. Issue(U, A1, g, ch, R, s) @ #j & #j < #i & ((s = op) | (Ex r. s = op + r)))"

// P3b Prefix closure: every issued chain extends a chain the AS issued earlier for the same grant.
lemma chain_prefix_issued:
  "All U A1 g Ap An R s p #i. Hop(U, A1, g, Ap, An, R, s, p) @ #i ==>
     (Ex aud s1 #j. Issue(U, A1, g, p, aud, s1) @ #j & #j < #i)"

// P3d Purpose separation: every hop extends a delegation credential (a token whose audience is the AS);
// a token issued for a resource can be used at that resource but never exchanged.
lemma extends_delegation_credential:
  "All U A1 g Ap An R s p #i. Hop(U, A1, g, Ap, An, R, s, p) @ #i ==>
     (Ex s1 #j. Issue(U, A1, g, p, 'as', s1) @ #j & #j < #i)"

// Helper: every issued token belongs to a grant the user made earlier.
lemma issue_has_grant [use_induction, reuse]:
  "All U A1 g ch aud s #i. Issue(U, A1, g, ch, aud, s) @ #i ==>
     (Ex s0 #j. Grant(U, A1, s0, g) @ #j & #j < #i)"

// P3c Hop authenticity: each hop whose delegator is honest was requested by that delegator,
// to that delegate, for that audience and scope.
lemma hop_authentic:
  "All U A1 g Ap An R s p #i. Hop(U, A1, g, Ap, An, R, s, p) @ #i
     & not (Ex #c. Compromised(Ap) @ #c) ==>
     (Ex #j. Delegate(Ap, An, R, U, s, p) @ #j & #j < #i)"

// P4 No replay of an honest holder's request.
lemma no_replay:
  "All R U A1 g ch op n #i #k. Accept(R, U, A1, g, ch, op, n) @ #i & Accept(R, U, A1, g, ch, op, n) @ #k
     ==> #i = #k"

// P5 Revocation: anything accepted after a revocation used a token issued before it.
lemma revocation:
  "All R U A1 g ch op n #i #j. Accept(R, U, A1, g, ch, op, n) @ #i & Revoke(g) @ #j & #j < #i ==>
     (Ex aud s #k. Issue(U, A1, g, ch, aud, s) @ #k & #k < #j)"

// Attacker-strength variants
lemma holder_and_audience_network_only:
  "All R U A1 g Al p op n #i. Accept(R, U, A1, g, <Al, p>, op, n) @ #i
     & not (Ex X #c. Compromised(X) @ #c) ==>
     (Ex #j. Send(Al, R, U, <Al, p>, op, n) @ #j & #j < #i)"

lemma hop_authentic_network_only:
  "All U A1 g Ap An R s p #i. Hop(U, A1, g, Ap, An, R, s, p) @ #i
     & not (Ex X #c. Compromised(X) @ #c) ==>
     (Ex #j. Delegate(Ap, An, R, U, s, p) @ #j & #j < #i)"


// NV1: a token issued before revocation can still be used after it (P5's premise is reachable).
lemma nv_used_after_revocation:
  exists-trace
  "Ex R U A1 A2 g op n #i #j. Accept(R, U, A1, g, <A2, A1>, op, n) @ #i & Revoke(g) @ #j & #j < #i
     & not (Ex X #c. Compromised(X) @ #c)"

// NV2: the replay cache does not block repeated honest use: two requests with different nonces are accepted.
lemma nv_repeated_use:
  exists-trace
  "Ex R U A1 A2 g op n1 n2 #i #k. Accept(R, U, A1, g, <A2, A1>, op, n1) @ #i & Accept(R, U, A1, g, <A2, A1>, op, n2) @ #k
     & not (n1 = n2) & not (Ex X #c. Compromised(X) @ #c)"

// NV3: compromise is reachable: a compromised holder gets a request accepted (P2's condition is not vacuous).
lemma nv_compromised_holder:
  exists-trace
  "Ex R U A1 A2 g op n #i #c. Accept(R, U, A1, g, <A2, A1>, op, n) @ #i & Compromised(A2) @ #c"

// P1c Refinement closure: every refined entry refines an entry of a token issued earlier under the
// same grant, so (by induction on refinement steps) each accepted entry is reached from a granted entry
// by a finite chain of AS refinements cn(.,.).
lemma refine_closure:
  "All U A1 g e c ch aud s1 #i. Refine(U, A1, g, e, c, ch, aud, s1) @ #i ==>
     (Ex #j. Issue(U, A1, g, ch, aud, s1) @ #j & #j < #i)"

// P1d Coverage: the refined entry is an entry of the presented token's scope.
lemma refine_covers:
  "All U A1 g e c ch aud s1 #i. Refine(U, A1, g, e, c, ch, aud, s1) @ #i ==> (s1 = e) | (Ex r. s1 = e + r)"

// P5a Notice authenticity: a resource learns of a revocation only if the user revoked the grant.
lemma notice_authentic:
  "All R g #i. RLearn(R, g) @ #i ==> (Ex #j. Revoke(g) @ #j & #j < #i)"

// P5b Push effectiveness: after a resource learns of the revocation of g, it accepts nothing under g.
lemma push_effective:
  "All R U A1 g ch op n #i #j. Accept(R, U, A1, g, ch, op, n) @ #i & RLearn(R, g) @ #j ==> #i < #j"


// Invariant (by induction): every token the AS issues carries a scope within the user's grant.
lemma scope_invariant [use_induction, reuse]:
  "All U A1 g ch aud s #i. Issue(U, A1, g, ch, aud, s) @ #i ==>
     (Ex s0 #j. Grant(U, A1, s0, g) @ #j & #j < #i & ((s0 = s) | (Ex r. s0 = s + r)))
   | (Ex p pc pa ps #j. Refine(U, A1, g, p, s, pc, pa, ps) @ #j & ((#j < #i) | (#j = #i)))"

// P1 No escalation, for chains of any length and with every agent possibly compromised.
lemma attenuation:
  "All R U A1 g ch op n #i. Accept(R, U, A1, g, ch, op, n) @ #i ==>
     (Ex s0 #j. Grant(U, A1, s0, g) @ #j & ((s0 = op) | (Ex r. s0 = op + r)))
   | (Ex p pc pa ps #j. Refine(U, A1, g, p, op, pc, pa, ps) @ #j & #j < #i)"


lemma attenuation_honest_agents:
  "All R U A1 g ch op n #i. Accept(R, U, A1, g, ch, op, n) @ #i & not (Ex X #c. Compromised(X) @ #c) ==>
     (Ex s0 #j. Grant(U, A1, s0, g) @ #j & ((s0 = op) | (Ex r. s0 = op + r)))
   | (Ex p pc pa ps #j. Refine(U, A1, g, p, op, pc, pa, ps) @ #j & #j < #i)"


// Witness against P5a: a resource learns of a revocation the user never made (denial of service).
lemma attack_forged_revocation:
  exists-trace
  "Ex R U A1 s g #i #k. RLearn(R, g) @ #i & Grant(U, A1, s, g) @ #k & not (Ex #j. Revoke(g) @ #j)"

end
