lemma notice_authentic:
  all-traces
  "∀ R g #i.
    (RLearn( R, g ) @ #i) ⇒ (∃ #j. (Revoke( g ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ R g #i. (RLearn( R, g ) @ #i) ∧ ∀ #j. (Revoke( g ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

