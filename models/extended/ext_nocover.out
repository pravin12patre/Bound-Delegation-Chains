lemma scope_invariant [use_induction]:
  all-traces
  "∀ U A1 g ch aud s #i.
    (Issue( U, A1, g, ch, aud, s ) @ #i) ⇒
    ((∃ s0 #j.
       ((Grant( U, A1, s0, g ) @ #j) ∧ (#j < #i)) ∧
       ((s0 = s) ∨ (∃ r. s0 = (r++s)))) ∨
     (∃ p pc pa ps #j.
       (Refine( U, A1, g, p, s, pc, pa, ps ) @ #j) ∧ ((#j < #i) ∨ (#j = #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g ch aud s #i.
  (Issue( U, A1, g, ch, aud, s ) @ #i)
 ∧
  (∀ s0 #j.
    (Grant( U, A1, s0, g ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨ ((¬(s0 = s)) ∧ (∀ r. (s0 = (r++s)) ⇒ ⊥)))) ∧
  (∀ p pc pa ps #j.
    (Refine( U, A1, g, p, s, pc, pa, ps ) @ #j)
   ⇒
    (¬(#j < #i)) ∧ (¬(#j = #i)))"
*/
by sorry

