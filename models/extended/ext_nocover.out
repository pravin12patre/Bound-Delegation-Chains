theory BDC_ext_nocover begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: cn/2, fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true









rule (modulo E) Agent_key:
   [ Fr( ~k ) ]
  --[ KeyGen( $X ) ]->
   [ !Ltk( $X, ~k ), !Pk( $X, pk(~k) ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_agent:
   [ !Ltk( X, k ) ] --[ Compromised( X ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AS_key:
   [ Fr( ~kas ) ]
  --[ OnlyOnceAS( ) ]->
   [ !LtkAS( ~kas ), !PkAS( pk(~kas) ), Out( pk(~kas) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Consent:
   [ Fr( ~g ), In( s ) ]
  --[ Grant( $U, $A1, s, ~g ) ]->
   [ !Consent( $U, $A1, s, ~g ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Revoke:
   [ !Consent( U, A1, s, g ), !LtkAS( kas ) ]
  --[ Revoke( g ) ]->
   [ Out( <<'REV', g>, sign(<'REV', g>, kas)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) R_learn_revocation:
   [ !PkAS( pkas ), In( <<'REV', g>, sg> ) ]
  --[ Eq( verify(sg, <'REV', g>, pkas), true ), RLearn( $R, g ) ]->
   [ !RRevoked( $R, g ) ]

  /*
  rule (modulo AC) R_learn_revocation:
     [ !PkAS( pkas ), In( <<'REV', g>, sg> ) ]
    --[ Eq( z, true ), RLearn( $R, g ) ]->
     [ !RRevoked( $R, g ) ]
    variants (modulo AC)
    1. g     = g.8
       pkas  = pkas.9
       sg    = sg.10
       z     = verify(sg.10, <'REV', g.8>, pkas.9)
    
    2. g     = g.9
       pkas  = pk(x.15)
       sg    = sign(<'REV', g.9>, x.15)
       z     = true
  */

rule (modulo E) AS_issue_root:
   [ !Consent( U, A1, s, g ), !Pk( A1, pk1 ), !LtkAS( kas ) ]
  --[ Issue( U, A1, g, A1, 'as', s ), Live( g ) ]->
   [
   Out( <<'T', U, A1, g, A1, 'as', s, pk1>, 
         sign(<'T', U, A1, g, A1, 'as', s, pk1>, kas)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Agent_delegate_root_eq:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, X, 'as', s, pk(k)>, sig> ), In( <An, R> ), Fr( ~nx )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, X, 'as', s, pk(k)>, pkas), true ),
  Delegate( X, An, R, U, s, X )
  ]->
   [
   Out( <<'XR', <'T', U, A1, g, X, 'as', s, pk(k)>, sig, An, R, s, ~nx>, 
         sign(<'XR', <'T', U, A1, g, X, 'as', s, pk(k)>, sig, An, R, s, ~nx>, k)>
   )
   ]

  /*
  rule (modulo AC) Agent_delegate_root_eq:
     [
     !Ltk( X, k ), !PkAS( pkas ),
     In( <<'T', U, A1, g, X, 'as', s, pk(k)>, sig> ), In( <An, R> ), Fr( ~nx )
     ]
    --[ Eq( z, true ), Delegate( X, An, R, U, s, X ) ]->
     [
     Out( <<'XR', <'T', U, A1, g, X, 'as', s, pk(k)>, sig, An, R, s, ~nx>, 
           sign(<'XR', <'T', U, A1, g, X, 'as', s, pk(k)>, sig, An, R, s, ~nx>, k)>
     )
     ]
    variants (modulo AC)
    1. A1    = A1.26
       U     = U.29
       X     = X.30
       g     = g.31
       k     = k.32
       pkas  = pkas.33
       s     = s.34
       sig   = sig.35
       z     = verify(sig.35,
                      <'T', U.29, A1.26, g.31, X.30, 'as', s.34, pk(k.32)>, pkas.33)
    
    2. A1    = A1.52
       U     = U.55
       X     = X.56
       g     = g.57
       k     = k.58
       pkas  = pk(x.101)
       s     = s.60
       sig   = sign(<'T', U.55, A1.52, g.57, X.56, 'as', s.60, pk(k.58)>, x.101)
       z     = true
  */

rule (modulo E) Agent_delegate_root_sub:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, X, 'as', (rest++s2), pk(k)>, sig> ), In( <An, R> ),
   Fr( ~nx )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, X, 'as', (rest++s2), pk(k)>, pkas), true
  ),
  Delegate( X, An, R, U, s2, X )
  ]->
   [
   Out( <
         <'XR', <'T', U, A1, g, X, 'as', (rest++s2), pk(k)>, sig, An, R, s2, ~nx
         >, 
         sign(<'XR', <'T', U, A1, g, X, 'as', (rest++s2), pk(k)>, sig, An, R, s2, 
               ~nx>,
              k)
        >
   )
   ]

  /*
  rule (modulo AC) Agent_delegate_root_sub:
     [
     !Ltk( X, k ), !PkAS( pkas ),
     In( <<'T', U, A1, g, X, 'as', (rest++s2), pk(k)>, sig> ), In( <An, R> ),
     Fr( ~nx )
     ]
    --[ Eq( z, true ), Delegate( X, An, R, U, s2, X ) ]->
     [
     Out( <
           <'XR', <'T', U, A1, g, X, 'as', (rest++s2), pk(k)>, sig, An, R, s2, ~nx
           >, 
           sign(<'XR', <'T', U, A1, g, X, 'as', (rest++s2), pk(k)>, sig, An, R, s2, 
                 ~nx>,
                k)
          >
     )
     ]
    variants (modulo AC)
    1. A1    = A1.28
       U     = U.31
       X     = X.32
       g     = g.33
       k     = k.34
       pkas  = pkas.35
       rest  = rest.36
       s2    = s2.37
       sig   = sig.38
       z     = verify(sig.38,
                      <'T', U.31, A1.28, g.33, X.32, 'as', (rest.36++s2.37), pk(k.34)>,
                      pkas.35)
    
    2. A1    = A1.55
       U     = U.58
       X     = X.59
       g     = g.60
       k     = k.61
       pkas  = pk(x.107)
       rest  = rest.63
       s2    = s2.64
       sig   = sign(<'T', U.58, A1.55, g.60, X.59, 'as', (rest.63++s2.64), 
                     pk(k.61)>,
                    x.107)
       z     = true
  */

rule (modulo E) Agent_delegate_deleg_eq:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, <X, p>, 'as', s, pk(k)>, sig> ), In( <An, R> ),
   Fr( ~nx )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <X, p>, 'as', s, pk(k)>, pkas), true ),
  Delegate( X, An, R, U, s, <X, p> )
  ]->
   [
   Out( <
         <'XR', <'T', U, A1, g, <X, p>, 'as', s, pk(k)>, sig, An, R, s, ~nx>, 
         sign(<'XR', <'T', U, A1, g, <X, p>, 'as', s, pk(k)>, sig, An, R, s, ~nx>,
              k)
        >
   )
   ]

  /*
  rule (modulo AC) Agent_delegate_deleg_eq:
     [
     !Ltk( X, k ), !PkAS( pkas ),
     In( <<'T', U, A1, g, <X, p>, 'as', s, pk(k)>, sig> ), In( <An, R> ),
     Fr( ~nx )
     ]
    --[ Eq( z, true ), Delegate( X, An, R, U, s, <X, p> ) ]->
     [
     Out( <
           <'XR', <'T', U, A1, g, <X, p>, 'as', s, pk(k)>, sig, An, R, s, ~nx>, 
           sign(<'XR', <'T', U, A1, g, <X, p>, 'as', s, pk(k)>, sig, An, R, s, ~nx>,
                k)
          >
     )
     ]
    variants (modulo AC)
    1. A1    = A1.28
       U     = U.31
       X     = X.32
       g     = g.33
       k     = k.34
       p     = p.35
       pkas  = pkas.36
       s     = s.37
       sig   = sig.38
       z     = verify(sig.38,
                      <'T', U.31, A1.28, g.33, <X.32, p.35>, 'as', s.37, pk(k.34)>, pkas.36)
    
    2. A1    = A1.56
       U     = U.59
       X     = X.60
       g     = g.61
       k     = k.62
       p     = p.63
       pkas  = pk(x.109)
       s     = s.65
       sig   = sign(<'T', U.59, A1.56, g.61, <X.60, p.63>, 'as', s.65, pk(k.62)
                    >,
                    x.109)
       z     = true
  */

rule (modulo E) Agent_delegate_deleg_sub:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, <X, p>, 'as', (rest++s2), pk(k)>, sig> ),
   In( <An, R> ), Fr( ~nx )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <X, p>, 'as', (rest++s2), pk(k)>, pkas),
      true
  ),
  Delegate( X, An, R, U, s2, <X, p> )
  ]->
   [
   Out( <
         <'XR', <'T', U, A1, g, <X, p>, 'as', (rest++s2), pk(k)>, sig, An, R, s2, 
          ~nx>, 
         sign(<'XR', <'T', U, A1, g, <X, p>, 'as', (rest++s2), pk(k)>, sig, An, 
               R, s2, ~nx>,
              k)
        >
   )
   ]

  /*
  rule (modulo AC) Agent_delegate_deleg_sub:
     [
     !Ltk( X, k ), !PkAS( pkas ),
     In( <<'T', U, A1, g, <X, p>, 'as', (rest++s2), pk(k)>, sig> ),
     In( <An, R> ), Fr( ~nx )
     ]
    --[ Eq( z, true ), Delegate( X, An, R, U, s2, <X, p> ) ]->
     [
     Out( <
           <'XR', <'T', U, A1, g, <X, p>, 'as', (rest++s2), pk(k)>, sig, An, R, s2, 
            ~nx>, 
           sign(<'XR', <'T', U, A1, g, <X, p>, 'as', (rest++s2), pk(k)>, sig, An, 
                 R, s2, ~nx>,
                k)
          >
     )
     ]
    variants (modulo AC)
    1. A1    = A1.30
       U     = U.33
       X     = X.34
       g     = g.35
       k     = k.36
       p     = p.37
       pkas  = pkas.38
       rest  = rest.39
       s2    = s2.40
       sig   = sig.41
       z     = verify(sig.41,
                      <'T', U.33, A1.30, g.35, <X.34, p.37>, 'as', (rest.39++s2.40), pk(k.36)>,
                      pkas.38)
    
    2. A1    = A1.59
       U     = U.62
       X     = X.63
       g     = g.64
       k     = k.65
       p     = p.66
       pkas  = pk(x.115)
       rest  = rest.68
       s2    = s2.69
       sig   = sign(<'T', U.62, A1.59, g.64, <X.63, p.66>, 'as', 
                     (rest.68++s2.69), pk(k.65)>,
                    x.115)
       z     = true
  */

rule (modulo E) AS_exchange_root_eq:
   [
   !LtkAS( kas ), !Pk( An, pkn ),
   In( <<'XR', <'T', U, A1, g, A1, 'as', s, pkh>, sig, An, R, s, nx>, sx> )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, A1, 'as', s, pkh>, pk(kas)), true ),
  Eq( verify(sx,
             <'XR', <'T', U, A1, g, A1, 'as', s, pkh>, sig, An, R, s, nx>, pkh),
      true
  ),
  Issue( U, A1, g, <An, A1>, R, s ), Hop( U, A1, g, A1, An, R, s, A1 ),
  Live( g )
  ]->
   [
   Out( <<'T', U, A1, g, <An, A1>, R, s, pkn>, 
         sign(<'T', U, A1, g, <An, A1>, R, s, pkn>, kas)>
   )
   ]

  /*
  rule (modulo AC) AS_exchange_root_eq:
     [
     !LtkAS( kas ), !Pk( An, pkn ),
     In( <<'XR', <'T', U, A1, g, A1, 'as', s, pkh>, sig, An, R, s, nx>, sx> )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), Issue( U, A1, g, <An, A1>, R, s ),
    Hop( U, A1, g, A1, An, R, s, A1 ), Live( g )
    ]->
     [
     Out( <<'T', U, A1, g, <An, A1>, R, s, pkn>, 
           sign(<'T', U, A1, g, <An, A1>, R, s, pkn>, kas)>
     )
     ]
    variants (modulo AC)
    1. A1    = A1.30
       An    = An.31
       R     = R.32
       U     = U.33
       g     = g.34
       kas   = kas.35
       nx    = nx.36
       pkh   = pkh.37
       s     = s.39
       sig   = sig.40
       sx    = sx.41
       z     = verify(sig.40,
                      <'T', U.33, A1.30, g.34, A1.30, 'as', s.39, pkh.37>, pk(kas.35))
       z.1   = verify(sx.41,
                      <'XR', <'T', U.33, A1.30, g.34, A1.30, 'as', s.39, pkh.37>, sig.40, 
                       An.31, R.32, s.39, nx.36>,
                      pkh.37)
    
    2. A1    = A1.30
       An    = An.31
       R     = R.32
       U     = U.33
       g     = g.34
       kas   = kas.35
       nx    = nx.36
       pkh   = pkh.37
       s     = s.39
       sig   = sign(<'T', U.33, A1.30, g.34, A1.30, 'as', s.39, pkh.37>, kas.35)
       sx    = sx.41
       z     = true
       z.1   = verify(sx.41,
                      <'XR', <'T', U.33, A1.30, g.34, A1.30, 'as', s.39, pkh.37>, 
                       sign(<'T', U.33, A1.30, g.34, A1.30, 'as', s.39, pkh.37>, kas.35), 
                       An.31, R.32, s.39, nx.36>,
                      pkh.37)
    
    3. A1    = A1.60
       An    = An.61
       R     = R.62
       U     = U.63
       g     = g.64
       kas   = kas.65
       nx    = nx.66
       pkh   = pk(x.118)
       s     = s.69
       sig   = sig.70
       sx    = sign(<'XR', 
                     <'T', U.63, A1.60, g.64, A1.60, 'as', s.69, pk(x.118)>, sig.70, An.61, 
                     R.62, s.69, nx.66>,
                    x.118)
       z     = verify(sig.70,
                      <'T', U.63, A1.60, g.64, A1.60, 'as', s.69, pk(x.118)>, pk(kas.65))
       z.1   = true
    
    4. A1    = A1.60
       An    = An.61
       R     = R.62
       U     = U.63
       g     = g.64
       kas   = kas.65
       nx    = nx.66
       pkh   = pk(x.118)
       s     = s.69
       sig   = sign(<'T', U.63, A1.60, g.64, A1.60, 'as', s.69, pk(x.118)>,
                    kas.65)
       sx    = sign(<'XR', 
                     <'T', U.63, A1.60, g.64, A1.60, 'as', s.69, pk(x.118)>, 
                     sign(<'T', U.63, A1.60, g.64, A1.60, 'as', s.69, pk(x.118)>, kas.65), 
                     An.61, R.62, s.69, nx.66>,
                    x.118)
       z     = true
       z.1   = true
  */

rule (modulo E) AS_exchange_root_sub:
   [
   !LtkAS( kas ), !Pk( An, pkn ),
   In( <
        <'XR', <'T', U, A1, g, A1, 'as', (rest++s2), pkh>, sig, An, R, s2, nx>, 
        sx>
   )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, A1, 'as', (rest++s2), pkh>, pk(kas)),
      true
  ),
  Eq( verify(sx,
             <'XR', <'T', U, A1, g, A1, 'as', (rest++s2), pkh>, sig, An, R, s2, nx>,
             pkh),
      true
  ),
  Issue( U, A1, g, <An, A1>, R, s2 ), Hop( U, A1, g, A1, An, R, s2, A1 ),
  Live( g )
  ]->
   [
   Out( <<'T', U, A1, g, <An, A1>, R, s2, pkn>, 
         sign(<'T', U, A1, g, <An, A1>, R, s2, pkn>, kas)>
   )
   ]

  /*
  rule (modulo AC) AS_exchange_root_sub:
     [
     !LtkAS( kas ), !Pk( An, pkn ),
     In( <
          <'XR', <'T', U, A1, g, A1, 'as', (rest++s2), pkh>, sig, An, R, s2, nx>, 
          sx>
     )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), Issue( U, A1, g, <An, A1>, R, s2 ),
    Hop( U, A1, g, A1, An, R, s2, A1 ), Live( g )
    ]->
     [
     Out( <<'T', U, A1, g, <An, A1>, R, s2, pkn>, 
           sign(<'T', U, A1, g, <An, A1>, R, s2, pkn>, kas)>
     )
     ]
    variants (modulo AC)
    1. A1    = A1.32
       An    = An.33
       R     = R.34
       U     = U.35
       g     = g.36
       kas   = kas.37
       nx    = nx.38
       pkh   = pkh.39
       rest  = rest.41
       s2    = s2.42
       sig   = sig.43
       sx    = sx.44
       z     = verify(sig.43,
                      <'T', U.35, A1.32, g.36, A1.32, 'as', (rest.41++s2.42), pkh.39>,
                      pk(kas.37))
       z.1   = verify(sx.44,
                      <'XR', <'T', U.35, A1.32, g.36, A1.32, 'as', (rest.41++s2.42), pkh.39>, 
                       sig.43, An.33, R.34, s2.42, nx.38>,
                      pkh.39)
    
    2. A1    = A1.32
       An    = An.33
       R     = R.34
       U     = U.35
       g     = g.36
       kas   = kas.37
       nx    = nx.38
       pkh   = pkh.39
       rest  = rest.41
       s2    = s2.42
       sig   = sign(<'T', U.35, A1.32, g.36, A1.32, 'as', (rest.41++s2.42), 
                     pkh.39>,
                    kas.37)
       sx    = sx.44
       z     = true
       z.1   = verify(sx.44,
                      <'XR', <'T', U.35, A1.32, g.36, A1.32, 'as', (rest.41++s2.42), pkh.39>, 
                       sign(<'T', U.35, A1.32, g.36, A1.32, 'as', (rest.41++s2.42), pkh.39>,
                            kas.37), 
                       An.33, R.34, s2.42, nx.38>,
                      pkh.39)
    
    3. A1    = A1.63
       An    = An.64
       R     = R.65
       U     = U.66
       g     = g.67
       kas   = kas.68
       nx    = nx.69
       pkh   = pk(x.124)
       rest  = rest.72
       s2    = s2.73
       sig   = sig.74
       sx    = sign(<'XR', 
                     <'T', U.66, A1.63, g.67, A1.63, 'as', (rest.72++s2.73), pk(x.124)>, 
                     sig.74, An.64, R.65, s2.73, nx.69>,
                    x.124)
       z     = verify(sig.74,
                      <'T', U.66, A1.63, g.67, A1.63, 'as', (rest.72++s2.73), pk(x.124)>,
                      pk(kas.68))
       z.1   = true
    
    4. A1    = A1.63
       An    = An.64
       R     = R.65
       U     = U.66
       g     = g.67
       kas   = kas.68
       nx    = nx.69
       pkh   = pk(x.124)
       rest  = rest.72
       s2    = s2.73
       sig   = sign(<'T', U.66, A1.63, g.67, A1.63, 'as', (rest.72++s2.73), 
                     pk(x.124)>,
                    kas.68)
       sx    = sign(<'XR', 
                     <'T', U.66, A1.63, g.67, A1.63, 'as', (rest.72++s2.73), pk(x.124)>, 
                     sign(<'T', U.66, A1.63, g.67, A1.63, 'as', (rest.72++s2.73), pk(x.124)>,
                          kas.68), 
                     An.64, R.65, s2.73, nx.69>,
                    x.124)
       z     = true
       z.1   = true
  */

rule (modulo E) AS_exchange_deleg_eq:
   [
   !LtkAS( kas ), !Pk( An, pkn ),
   In( <<'XR', <'T', U, A1, g, <Ap, p>, 'as', s, pkh>, sig, An, R, s, nx>, 
        sx>
   )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <Ap, p>, 'as', s, pkh>, pk(kas)), true ),
  Eq( verify(sx,
             <'XR', <'T', U, A1, g, <Ap, p>, 'as', s, pkh>, sig, An, R, s, nx>, pkh),
      true
  ),
  Issue( U, A1, g, <An, Ap, p>, R, s ),
  Hop( U, A1, g, Ap, An, R, s, <Ap, p> ), Live( g )
  ]->
   [
   Out( <<'T', U, A1, g, <An, Ap, p>, R, s, pkn>, 
         sign(<'T', U, A1, g, <An, Ap, p>, R, s, pkn>, kas)>
   )
   ]

  /*
  rule (modulo AC) AS_exchange_deleg_eq:
     [
     !LtkAS( kas ), !Pk( An, pkn ),
     In( <<'XR', <'T', U, A1, g, <Ap, p>, 'as', s, pkh>, sig, An, R, s, nx>, 
          sx>
     )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), Issue( U, A1, g, <An, Ap, p>, R, s ),
    Hop( U, A1, g, Ap, An, R, s, <Ap, p> ), Live( g )
    ]->
     [
     Out( <<'T', U, A1, g, <An, Ap, p>, R, s, pkn>, 
           sign(<'T', U, A1, g, <An, Ap, p>, R, s, pkn>, kas)>
     )
     ]
    variants (modulo AC)
    1. A1    = A1.34
       An    = An.35
       Ap    = Ap.36
       R     = R.37
       U     = U.38
       g     = g.39
       kas   = kas.40
       nx    = nx.41
       p     = p.42
       pkh   = pkh.43
       s     = s.45
       sig   = sig.46
       sx    = sx.47
       z     = verify(sig.46,
                      <'T', U.38, A1.34, g.39, <Ap.36, p.42>, 'as', s.45, pkh.43>, pk(kas.40))
       z.1   = verify(sx.47,
                      <'XR', <'T', U.38, A1.34, g.39, <Ap.36, p.42>, 'as', s.45, pkh.43>, 
                       sig.46, An.35, R.37, s.45, nx.41>,
                      pkh.43)
    
    2. A1    = A1.34
       An    = An.35
       Ap    = Ap.36
       R     = R.37
       U     = U.38
       g     = g.39
       kas   = kas.40
       nx    = nx.41
       p     = p.42
       pkh   = pkh.43
       s     = s.45
       sig   = sign(<'T', U.38, A1.34, g.39, <Ap.36, p.42>, 'as', s.45, pkh.43>,
                    kas.40)
       sx    = sx.47
       z     = true
       z.1   = verify(sx.47,
                      <'XR', <'T', U.38, A1.34, g.39, <Ap.36, p.42>, 'as', s.45, pkh.43>, 
                       sign(<'T', U.38, A1.34, g.39, <Ap.36, p.42>, 'as', s.45, pkh.43>,
                            kas.40), 
                       An.35, R.37, s.45, nx.41>,
                      pkh.43)
    
    3. A1    = A1.68
       An    = An.69
       Ap    = Ap.70
       R     = R.71
       U     = U.72
       g     = g.73
       kas   = kas.74
       nx    = nx.75
       p     = p.76
       pkh   = pk(x.134)
       s     = s.79
       sig   = sig.80
       sx    = sign(<'XR', 
                     <'T', U.72, A1.68, g.73, <Ap.70, p.76>, 'as', s.79, pk(x.134)>, sig.80, 
                     An.69, R.71, s.79, nx.75>,
                    x.134)
       z     = verify(sig.80,
                      <'T', U.72, A1.68, g.73, <Ap.70, p.76>, 'as', s.79, pk(x.134)>,
                      pk(kas.74))
       z.1   = true
    
    4. A1    = A1.68
       An    = An.69
       Ap    = Ap.70
       R     = R.71
       U     = U.72
       g     = g.73
       kas   = kas.74
       nx    = nx.75
       p     = p.76
       pkh   = pk(x.134)
       s     = s.79
       sig   = sign(<'T', U.72, A1.68, g.73, <Ap.70, p.76>, 'as', s.79, 
                     pk(x.134)>,
                    kas.74)
       sx    = sign(<'XR', 
                     <'T', U.72, A1.68, g.73, <Ap.70, p.76>, 'as', s.79, pk(x.134)>, 
                     sign(<'T', U.72, A1.68, g.73, <Ap.70, p.76>, 'as', s.79, pk(x.134)>,
                          kas.74), 
                     An.69, R.71, s.79, nx.75>,
                    x.134)
       z     = true
       z.1   = true
  */

rule (modulo E) AS_exchange_deleg_sub:
   [
   !LtkAS( kas ), !Pk( An, pkn ),
   In( <
        <'XR', <'T', U, A1, g, <Ap, p>, 'as', (rest++s2), pkh>, sig, An, R, s2, 
         nx>, 
        sx>
   )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <Ap, p>, 'as', (rest++s2), pkh>,
             pk(kas)),
      true
  ),
  Eq( verify(sx,
             <'XR', <'T', U, A1, g, <Ap, p>, 'as', (rest++s2), pkh>, sig, An, R, s2, 
              nx>,
             pkh),
      true
  ),
  Issue( U, A1, g, <An, Ap, p>, R, s2 ),
  Hop( U, A1, g, Ap, An, R, s2, <Ap, p> ), Live( g )
  ]->
   [
   Out( <<'T', U, A1, g, <An, Ap, p>, R, s2, pkn>, 
         sign(<'T', U, A1, g, <An, Ap, p>, R, s2, pkn>, kas)>
   )
   ]

  /*
  rule (modulo AC) AS_exchange_deleg_sub:
     [
     !LtkAS( kas ), !Pk( An, pkn ),
     In( <
          <'XR', <'T', U, A1, g, <Ap, p>, 'as', (rest++s2), pkh>, sig, An, R, s2, 
           nx>, 
          sx>
     )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), Issue( U, A1, g, <An, Ap, p>, R, s2 ),
    Hop( U, A1, g, Ap, An, R, s2, <Ap, p> ), Live( g )
    ]->
     [
