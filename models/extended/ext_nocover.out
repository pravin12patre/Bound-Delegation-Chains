restriction PushedRevocation:
  "∀ R U A1 g ch op n #i #j.
    ((Accept( R, U, A1, g, ch, op, n ) @ #i) ∧ (RLearn( R, g ) @ #j)) ⇒
    (#i < #j)"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction SingleAS:
  "∀ #i #j. ((OnlyOnceAS( ) @ #i) ∧ (OnlyOnceAS( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OneKeyPerAgent:
  "∀ X #i #j. ((KeyGen( X ) @ #i) ∧ (KeyGen( X ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction RevokedGrant:
  "∀ g #i #j. ((Live( g ) @ #i) ∧ (Revoke( g ) @ #j)) ⇒ (#i < #j)"
  // safety formula

restriction ReplayCache:
  "∀ R n #i #j.
    ((RNonce( R, n ) @ #i) ∧ (RNonce( R, n ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma executable:
  exists-trace
  "∃ R U A1 A2 A3 g op n #i #k.
    (((((Accept( R, U, A1, g, <A3, A2, A1>, op, n ) @ #i) ∧
        (Grant( U, A1, op, g ) @ #k)) ∧
       (¬(∃ X #c. Compromised( X ) @ #c))) ∧
      (¬(A1 = A2))) ∧
     (¬(A2 = A3))) ∧
    (¬(A1 = A3))"
/*
guarded formula characterizing all satisfying traces:
"∃ R U A1 A2 A3 g op n #i #k.
  (Accept( R, U, A1, g, <A3, A2, A1>, op, n ) @ #i) ∧
  (Grant( U, A1, op, g ) @ #k)
 ∧
  (∀ X #c. (Compromised( X ) @ #c) ⇒ ⊥) ∧
  (¬(A1 = A2)) ∧
  (¬(A2 = A3)) ∧
  (¬(A1 = A3))"
*/
by sorry

lemma holder_and_audience:
  all-traces
  "∀ R U A1 g Al p op n #i.
    ((Accept( R, U, A1, g, <Al, p>, op, n ) @ #i) ∧
     (¬(∃ #c. Compromised( Al ) @ #c))) ⇒
    (∃ #j. (Send( Al, R, U, <Al, p>, op, n ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g Al p op n #i.
  (Accept( R, U, A1, g, <Al, p>, op, n ) @ #i)
 ∧
  (∀ #c. (Compromised( Al ) @ #c) ⇒ ⊥) ∧
  (∀ #j. (Send( Al, R, U, <Al, p>, op, n ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma accepted_chain_issued:
  all-traces
  "∀ R U A1 g ch op n #i.
    (Accept( R, U, A1, g, ch, op, n ) @ #i) ⇒
    (∃ s #j.
      ((Issue( U, A1, g, ch, R, s ) @ #j) ∧ (#j < #i)) ∧
      ((s = op) ∨ (∃ r. s = (op++r))))"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g ch op n #i.
  (Accept( R, U, A1, g, ch, op, n ) @ #i)
 ∧
  ∀ s #j.
   (Issue( U, A1, g, ch, R, s ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨ ((¬(s = op)) ∧ (∀ r. (s = (op++r)) ⇒ ⊥)))"
*/
by sorry

lemma chain_prefix_issued:
  all-traces
  "∀ U A1 g Ap An R s p #i.
    (Hop( U, A1, g, Ap, An, R, s, p ) @ #i) ⇒
    (∃ aud s1 #j. (Issue( U, A1, g, p, aud, s1 ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g Ap An R s p #i.
  (Hop( U, A1, g, Ap, An, R, s, p ) @ #i)
 ∧
  ∀ aud s1 #j. (Issue( U, A1, g, p, aud, s1 ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma extends_delegation_credential:
  all-traces
  "∀ U A1 g Ap An R s p #i.
    (Hop( U, A1, g, Ap, An, R, s, p ) @ #i) ⇒
    (∃ s1 #j. (Issue( U, A1, g, p, 'as', s1 ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g Ap An R s p #i.
  (Hop( U, A1, g, Ap, An, R, s, p ) @ #i)
 ∧
  ∀ s1 #j. (Issue( U, A1, g, p, 'as', s1 ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma issue_has_grant [use_induction, reuse]:
  all-traces
  "∀ U A1 g ch aud s #i.
    (Issue( U, A1, g, ch, aud, s ) @ #i) ⇒
    (∃ s0 #j. (Grant( U, A1, s0, g ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g ch aud s #i.
  (Issue( U, A1, g, ch, aud, s ) @ #i)
 ∧
  ∀ s0 #j. (Grant( U, A1, s0, g ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma hop_authentic:
  all-traces
  "∀ U A1 g Ap An R s p #i.
    ((Hop( U, A1, g, Ap, An, R, s, p ) @ #i) ∧
     (¬(∃ #c. Compromised( Ap ) @ #c))) ⇒
    (∃ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g Ap An R s p #i.
  (Hop( U, A1, g, Ap, An, R, s, p ) @ #i)
 ∧
  (∀ #c. (Compromised( Ap ) @ #c) ⇒ ⊥) ∧
  (∀ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma no_replay:
  all-traces
  "∀ R U A1 g ch op n #i #k.
    ((Accept( R, U, A1, g, ch, op, n ) @ #i) ∧
     (Accept( R, U, A1, g, ch, op, n ) @ #k)) ⇒
    (#i = #k)"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g ch op n #i #k.
  (Accept( R, U, A1, g, ch, op, n ) @ #i) ∧
  (Accept( R, U, A1, g, ch, op, n ) @ #k)
 ∧
  ¬(#i = #k)"
*/
by sorry

lemma revocation:
  all-traces
  "∀ R U A1 g ch op n #i #j.
    (((Accept( R, U, A1, g, ch, op, n ) @ #i) ∧ (Revoke( g ) @ #j)) ∧
     (#j < #i)) ⇒
    (∃ aud s #k. (Issue( U, A1, g, ch, aud, s ) @ #k) ∧ (#k < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g ch op n #i #j.
  (Accept( R, U, A1, g, ch, op, n ) @ #i) ∧ (Revoke( g ) @ #j)
 ∧
  (#j < #i) ∧
  (∀ aud s #k. (Issue( U, A1, g, ch, aud, s ) @ #k) ⇒ ¬(#k < #j))"
*/
by sorry

lemma holder_and_audience_network_only:
  all-traces
  "∀ R U A1 g Al p op n #i.
    ((Accept( R, U, A1, g, <Al, p>, op, n ) @ #i) ∧
     (¬(∃ X #c. Compromised( X ) @ #c))) ⇒
    (∃ #j. (Send( Al, R, U, <Al, p>, op, n ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ R U A1 g Al p op n #i.
  (Accept( R, U, A1, g, <Al, p>, op, n ) @ #i)
 ∧
  (∀ X #c. (Compromised( X ) @ #c) ⇒ ⊥) ∧
  (∀ #j. (Send( Al, R, U, <Al, p>, op, n ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma hop_authentic_network_only:
  all-traces
  "∀ U A1 g Ap An R s p #i.
    ((Hop( U, A1, g, Ap, An, R, s, p ) @ #i) ∧
     (¬(∃ X #c. Compromised( X ) @ #c))) ⇒
    (∃ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g Ap An R s p #i.
  (Hop( U, A1, g, Ap, An, R, s, p ) @ #i)
 ∧
  (∀ X #c. (Compromised( X ) @ #c) ⇒ ⊥) ∧
  (∀ #j. (Delegate( Ap, An, R, U, s, p ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma refine_closure:
  all-traces
  "∀ U A1 g e c ch aud s1 #i.
    (Refine( U, A1, g, e, c, ch, aud, s1 ) @ #i) ⇒
    (∃ #j. (Issue( U, A1, g, ch, aud, s1 ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g e c ch aud s1 #i.
  (Refine( U, A1, g, e, c, ch, aud, s1 ) @ #i)
 ∧
  ∀ #j. (Issue( U, A1, g, ch, aud, s1 ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( Refine( U, A1, g, e, c, ch, aud, s1 ) @ #i )
  case AS_exchange_deleg_refine_any
  solve( !LtkAS( kas ) ▶₀ #i )
    case AS_key
    solve( !Pk( An, pkn ) ▶₁ #i )
      case Agent_key
      solve( !KU( ~g ) @ #vk.11 )
        case AS_issue_root
        solve( !KU( sign(<'T', $U, $A1, ~g, <Ap, p>, 'as', s1, pk(x)>, ~kas)
               ) @ #vk.22 )
          case AS_exchange_deleg_eq
          by contradiction /* from formulas */
        next
          case AS_exchange_deleg_refine_any
          by contradiction /* from formulas */
        next
          case AS_exchange_deleg_sub
          by contradiction /* from formulas */
        next
          case AS_exchange_root_eq
          by contradiction /* from formulas */
        next
          case AS_exchange_root_refine_any
          by contradiction /* from formulas */
        next
          case AS_exchange_root_sub
          by contradiction /* from formulas */
        next
          case c_sign
          by solve( !KU( ~kas ) @ #vk.32 )
        qed
      next
        case Revoke
        by contradiction /* cyclic */
      qed
    qed
  qed
next
  case AS_exchange_root_refine_any
  solve( !LtkAS( kas ) ▶₀ #i )
    case AS_key
    solve( !Pk( An, pkn ) ▶₁ #i )
      case Agent_key
      solve( !KU( ~g ) @ #vk.12 )
        case AS_issue_root
        solve( !KU( sign(<'T', $U, $A1, ~g, $A1, 'as', s1, pk(x)>, ~kas)
               ) @ #vk.19 )
          case AS_issue_root
          by contradiction /* from formulas */
        next
          case c_sign
          by solve( !KU( ~kas ) @ #vk.29 )
        qed
      next
        case Revoke
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

lemma refine_covers:
  all-traces
  "∀ U A1 g e c ch aud s1 #i.
    (Refine( U, A1, g, e, c, ch, aud, s1 ) @ #i) ⇒
    ((s1 = e) ∨ (∃ r. s1 = (e++r)))"
/*
guarded formula characterizing all counter-examples:
"∃ U A1 g e c ch aud s1 #i.
  (Refine( U, A1, g, e, c, ch, aud, s1 ) @ #i)
 ∧
  (¬(s1 = e)) ∧ (∀ r. (s1 = (e++r)) ⇒ ⊥)"
*/
simplify
solve( Refine( U, A1, g, e, c, ch, aud, s1 ) @ #i )
  case AS_exchange_deleg_refine_any
