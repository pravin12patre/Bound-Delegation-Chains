           sign(<'T', U, A1, g, <An, Ap, p>, R, s2, pkn>, kas)>
     )
     ]
    variants (modulo AC)
    1. A1    = A1.36
       An    = An.37
       Ap    = Ap.38
       R     = R.39
       U     = U.40
       g     = g.41
       kas   = kas.42
       nx    = nx.43
       p     = p.44
       pkh   = pkh.45
       rest  = rest.47
       s2    = s2.48
       sig   = sig.49
       sx    = sx.50
       z     = verify(sig.49,
                      <'T', U.40, A1.36, g.41, <Ap.38, p.44>, 'as', (rest.47++s2.48), pkh.45>,
                      pk(kas.42))
       z.1   = verify(sx.50,
                      <'XR', 
                       <'T', U.40, A1.36, g.41, <Ap.38, p.44>, 'as', (rest.47++s2.48), pkh.45>, 
                       sig.49, An.37, R.39, s2.48, nx.43>,
                      pkh.45)
    
    2. A1    = A1.36
       An    = An.37
       Ap    = Ap.38
       R     = R.39
       U     = U.40
       g     = g.41
       kas   = kas.42
       nx    = nx.43
       p     = p.44
       pkh   = pkh.45
       rest  = rest.47
       s2    = s2.48
       sig   = sign(<'T', U.40, A1.36, g.41, <Ap.38, p.44>, 'as', 
                     (rest.47++s2.48), pkh.45>,
                    kas.42)
       sx    = sx.50
       z     = true
       z.1   = verify(sx.50,
                      <'XR', 
                       <'T', U.40, A1.36, g.41, <Ap.38, p.44>, 'as', (rest.47++s2.48), pkh.45>, 
                       sign(<'T', U.40, A1.36, g.41, <Ap.38, p.44>, 'as', (rest.47++s2.48), 
                             pkh.45>,
                            kas.42), 
                       An.37, R.39, s2.48, nx.43>,
                      pkh.45)
    
    3. A1    = A1.71
       An    = An.72
       Ap    = Ap.73
       R     = R.74
       U     = U.75
       g     = g.76
       kas   = kas.77
       nx    = nx.78
       p     = p.79
       pkh   = pk(x.140)
       rest  = rest.82
       s2    = s2.83
       sig   = sig.84
       sx    = sign(<'XR', 
                     <'T', U.75, A1.71, g.76, <Ap.73, p.79>, 'as', (rest.82++s2.83), pk(x.140)
                     >, 
                     sig.84, An.72, R.74, s2.83, nx.78>,
                    x.140)
       z     = verify(sig.84,
                      <'T', U.75, A1.71, g.76, <Ap.73, p.79>, 'as', (rest.82++s2.83), pk(x.140)
                      >,
                      pk(kas.77))
       z.1   = true
    
    4. A1    = A1.71
       An    = An.72
       Ap    = Ap.73
       R     = R.74
       U     = U.75
       g     = g.76
       kas   = kas.77
       nx    = nx.78
       p     = p.79
