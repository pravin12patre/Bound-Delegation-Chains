rule (modulo E) R_accept_eq:
   [
   !PkAS( pkas ),
   In( <<'T', U, A1, g, <Al, p>, $R, op, pkh>, sig, op, n, sr> )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <Al, p>, $R, op, pkh>, pkas), true ),
  Eq( verify(sr, <'REQ', <'T', U, A1, g, <Al, p>, $R, op, pkh>, op, $R, n>,
             pkh),
      true
  ),
  Accept( $R, U, A1, g, <Al, p>, op, n ), RNonce( $R, n )
  ]->
   [ ]

  /*
  rule (modulo AC) R_accept_eq:
     [
     !PkAS( pkas ),
     In( <<'T', U, A1, g, <Al, p>, $R, op, pkh>, sig, op, n, sr> )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), Accept( $R, U, A1, g, <Al, p>, op, n ),
    RNonce( $R, n )
    ]->
     [ ]
    variants (modulo AC)
    1. $R    = $R.17
       A1    = A1.18
       Al    = Al.19
       U     = U.20
       g     = g.21
       n     = n.22
       op    = op.23
       p     = p.24
       pkas  = pkas.25
       pkh   = pkh.26
       sig   = sig.27
       sr    = sr.28
       z     = verify(sig.27,
                      <'T', U.20, A1.18, g.21, <Al.19, p.24>, $R.17, op.23, pkh.26>, pkas.25)
       z.1   = verify(sr.28,
                      <'REQ', <'T', U.20, A1.18, g.21, <Al.19, p.24>, $R.17, op.23, pkh.26>, 
                       op.23, $R.17, n.22>,
                      pkh.26)
    
    2. $R    = $R.26
       A1    = A1.27
       Al    = Al.28
       U     = U.29
       g     = g.30
       n     = n.31
       op    = op.32
       p     = p.33
       pkas  = pk(x.49)
       pkh   = pk(x.50)
       sig   = sign(<'T', U.29, A1.27, g.30, <Al.28, p.33>, $R.26, op.32, 
                     pk(x.50)>,
                    x.49)
       sr    = sign(<'REQ', 
                     <'T', U.29, A1.27, g.30, <Al.28, p.33>, $R.26, op.32, pk(x.50)>, op.32, 
                     $R.26, n.31>,
                    x.50)
       z     = true
       z.1   = true
    
    3. $R    = $R.27
       A1    = A1.28
       Al    = Al.29
       U     = U.30
       g     = g.31
       n     = n.32
       op    = op.33
       p     = p.34
       pkas  = pkas.35
       pkh   = pk(x.51)
       sig   = sig.37
       sr    = sign(<'REQ', 
                     <'T', U.30, A1.28, g.31, <Al.29, p.34>, $R.27, op.33, pk(x.51)>, op.33, 
                     $R.27, n.32>,
                    x.51)
       z     = verify(sig.37,
                      <'T', U.30, A1.28, g.31, <Al.29, p.34>, $R.27, op.33, pk(x.51)>, pkas.35)
       z.1   = true
    
    4. $R    = $R.27
       A1    = A1.28
       Al    = Al.29
       U     = U.30
       g     = g.31
       n     = n.32
       op    = op.33
       p     = p.34
       pkas  = pk(x.50)
       pkh   = pkh.36
       sig   = sign(<'T', U.30, A1.28, g.31, <Al.29, p.34>, $R.27, op.33, pkh.36
                    >,
                    x.50)
       sr    = sr.38
       z     = true
       z.1   = verify(sr.38,
                      <'REQ', <'T', U.30, A1.28, g.31, <Al.29, p.34>, $R.27, op.33, pkh.36>, 
                       op.33, $R.27, n.32>,
                      pkh.36)
  */

rule (modulo E) R_accept_sub:
   [
