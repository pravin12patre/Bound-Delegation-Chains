                    >,
                    x.119)
       z     = true
  */

rule (modulo E) AS_exchange_root_refine_one:
   [
   !LtkAS( kas ), !Pk( An, pkn ),
   In( <
        <'XR', <'T', U, A1, g, A1, 'as', e, pkh>, sig, An, R, cn(e, kk), nx>, sx>
   )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, A1, 'as', e, pkh>, pk(kas)), true ),
  Eq( verify(sx,
             <'XR', <'T', U, A1, g, A1, 'as', e, pkh>, sig, An, R, cn(e, kk), nx>,
             pkh),
      true
  ),
  Issue( U, A1, g, <An, A1>, R, cn(e, kk) ),
  Hop( U, A1, g, A1, An, R, cn(e, kk), A1 ),
  Refine( U, A1, g, e, cn(e, kk), A1, 'as', e ), Live( g )
  ]->
   [
   Out( <<'T', U, A1, g, <An, A1>, R, cn(e, kk), pkn>, 
         sign(<'T', U, A1, g, <An, A1>, R, cn(e, kk), pkn>, kas)>
