       sr    = sr.41
       z     = true
       z.1   = verify(sr.41,
                      <'REQ', 
                       <'T', U.32, A1.30, g.33, <Al.31, p.36>, $R.29, (op.35++rest.39), pkh.38
                       >, 
                       op.35, $R.29, n.34>,
                      pkh.38)
  */

rule (modulo E) Agent_delegate_root_refine_one:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, X, 'as', e, pk(k)>, sig> ), In( <An, R, kk> ),
   Fr( ~nx )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, X, 'as', e, pk(k)>, pkas), true ),
  Delegate( X, An, R, U, cn(e, kk), X )
  ]->
   [
   Out( <
         <'XR', <'T', U, A1, g, X, 'as', e, pk(k)>, sig, An, R, cn(e, kk), ~nx>, 
         sign(<'XR', <'T', U, A1, g, X, 'as', e, pk(k)>, sig, An, R, cn(e, kk), 
               ~nx>,
              k)
        >
   )
   ]

  /*
  rule (modulo AC) Agent_delegate_root_refine_one:
     [
     !Ltk( X, k ), !PkAS( pkas ),
     In( <<'T', U, A1, g, X, 'as', e, pk(k)>, sig> ), In( <An, R, kk> ),
     Fr( ~nx )
     ]
    --[ Eq( z, true ), Delegate( X, An, R, U, cn(e, kk), X ) ]->
     [
     Out( <
           <'XR', <'T', U, A1, g, X, 'as', e, pk(k)>, sig, An, R, cn(e, kk), ~nx>, 
           sign(<'XR', <'T', U, A1, g, X, 'as', e, pk(k)>, sig, An, R, cn(e, kk), 
                 ~nx>,
                k)
          >
     )
     ]
    variants (modulo AC)
    1. A1    = A1.28
       U     = U.31
       X     = X.32
       e     = e.33
       g     = g.34
       k     = k.35
       pkas  = pkas.37
       sig   = sig.38
       z     = verify(sig.38,
                      <'T', U.31, A1.28, g.34, X.32, 'as', e.33, pk(k.35)>, pkas.37)
    
    2. A1    = A1.57
       U     = U.60
       X     = X.61
       e     = e.62
       g     = g.63
       k     = k.64
       pkas  = pk(x.111)
       sig   = sign(<'T', U.60, A1.57, g.63, X.61, 'as', e.62, pk(k.64)>, x.111)
       z     = true
  */

rule (modulo E) Agent_delegate_deleg_refine_one:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, <X, p>, 'as', e, pk(k)>, sig> ), In( <An, R, kk> ),
   Fr( ~nx )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <X, p>, 'as', e, pk(k)>, pkas), true ),
  Delegate( X, An, R, U, cn(e, kk), <X, p> )
  ]->
   [
   Out( <
         <'XR', <'T', U, A1, g, <X, p>, 'as', e, pk(k)>, sig, An, R, cn(e, kk), 
          ~nx>, 
         sign(<'XR', <'T', U, A1, g, <X, p>, 'as', e, pk(k)>, sig, An, R, 
               cn(e, kk), ~nx>,
              k)
        >
   )
   ]

