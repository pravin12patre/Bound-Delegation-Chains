                     (rest.82++s2.83), pk(x.140)>,
                    kas.77)
       sx    = sign(<'XR', 
                     <'T', U.75, A1.71, g.76, <Ap.73, p.79>, 'as', (rest.82++s2.83), pk(x.140)
                     >, 
                     sign(<'T', U.75, A1.71, g.76, <Ap.73, p.79>, 'as', (rest.82++s2.83), 
                           pk(x.140)>,
                          kas.77), 
                     An.72, R.74, s2.83, nx.78>,
                    x.140)
       z     = true
       z.1   = true
  */

rule (modulo E) Agent_invoke_eq:
   [
   !Ltk( X, k ), !PkAS( pkas ),
   In( <<'T', U, A1, g, <X, p>, R, op, pk(k)>, sig> ), Fr( ~n ), In( op )
   ]
  --[
  Eq( verify(sig, <'T', U, A1, g, <X, p>, R, op, pk(k)>, pkas), true ),
  Send( X, R, U, <X, p>, op, ~n )
  ]->
   [
   Out( <<'T', U, A1, g, <X, p>, R, op, pk(k)>, sig, op, ~n, 
         sign(<'REQ', <'T', U, A1, g, <X, p>, R, op, pk(k)>, op, R, ~n>, k)>
   )
   ]

  /*
  rule (modulo AC) Agent_invoke_eq:
     [
     !Ltk( X, k ), !PkAS( pkas ),
     In( <<'T', U, A1, g, <X, p>, R, op, pk(k)>, sig> ), Fr( ~n ), In( op )
     ]
    --[ Eq( z, true ), Send( X, R, U, <X, p>, op, ~n ) ]->
     [
     Out( <<'T', U, A1, g, <X, p>, R, op, pk(k)>, sig, op, ~n, 
           sign(<'REQ', <'T', U, A1, g, <X, p>, R, op, pk(k)>, op, R, ~n>, k)>
     )
     ]
    variants (modulo AC)
    1. A1    = A1.25
       R     = R.26
       U     = U.27
       X     = X.28
       g     = g.29
       k     = k.30
       op    = op.31
       p     = p.32
       pkas  = pkas.33
       sig   = sig.34
       z     = verify(sig.34,
                      <'T', U.27, A1.25, g.29, <X.28, p.32>, R.26, op.31, pk(k.30)>, pkas.33)
    
    2. A1    = A1.37
       R     = R.38
       U     = U.39
       X     = X.40
       g     = g.41
       k     = k.42
       op    = op.43
       p     = p.44
       pkas  = pk(x.71)
       sig   = sign(<'T', U.39, A1.37, g.41, <X.40, p.44>, R.38, op.43, pk(k.42)
                    >,
                    x.71)
       z     = true
  */

