       U     = U.35
       e     = e.36
       g     = g.37
       kas   = kas.38
       kk    = kk.39
       nx    = nx.40
       pkh   = pkh.41
       sig   = sign(<'T', U.35, A1.32, g.37, A1.32, 'as', e.36, pkh.41>, kas.38)
       sx    = sx.44
       z     = true
       z.1   = verify(sx.44,
                      <'XR', <'T', U.35, A1.32, g.37, A1.32, 'as', e.36, pkh.41>, 
                       sign(<'T', U.35, A1.32, g.37, A1.32, 'as', e.36, pkh.41>, kas.38), 
                       An.33, R.34, cn(e.36, kk.39), nx.40>,
                      pkh.41)
    
    3. A1    = A1.65
       An    = An.66
       R     = R.67
       U     = U.68
       e     = e.69
       g     = g.70
       kas   = kas.71
       kk    = kk.72
       nx    = nx.73
       pkh   = pk(x.128)
       sig   = sig.76
       sx    = sign(<'XR', 
                     <'T', U.68, A1.65, g.70, A1.65, 'as', e.69, pk(x.128)>, sig.76, An.66, 
                     R.67, cn(e.69, kk.72), nx.73>,
                    x.128)
       z     = verify(sig.76,
                      <'T', U.68, A1.65, g.70, A1.65, 'as', e.69, pk(x.128)>, pk(kas.71))
       z.1   = true
    
    4. A1    = A1.65
       An    = An.66
       R     = R.67
       U     = U.68
       e     = e.69
       g     = g.70
       kas   = kas.71
       kk    = kk.72
       nx    = nx.73
       pkh   = pk(x.128)
       sig   = sign(<'T', U.68, A1.65, g.70, A1.65, 'as', e.69, pk(x.128)>,
                    kas.71)
       sx    = sign(<'XR', 
                     <'T', U.68, A1.65, g.70, A1.65, 'as', e.69, pk(x.128)>, 
                     sign(<'T', U.68, A1.65, g.70, A1.65, 'as', e.69, pk(x.128)>, kas.71), 
                     An.66, R.67, cn(e.69, kk.72), nx.73>,
                    x.128)
       z     = true
       z.1   = true
  */

