                      <'T', U.35, A1.32, g.37, A1.32, 'as', e.36, pkh.41>, pk(kas.38))
       z.1   = verify(sx.44,
                      <'XR', <'T', U.35, A1.32, g.37, A1.32, 'as', e.36, pkh.41>, sig.43, 
                       An.33, R.34, cn(e.36, kk.39), nx.40>,
                      pkh.41)
    
    2. A1    = A1.32
       An    = An.33
